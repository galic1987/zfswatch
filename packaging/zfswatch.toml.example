# zfswatch configuration file
# Place at /etc/zfswatch/zfswatch.toml (Linux) or /usr/local/etc/zfswatch/zfswatch.toml (macOS)

[daemon]
# Unix socket path for daemon ↔ CLI communication
socket_path = "/run/zfswatch/zfswatch.sock"

# Automatically detect ZFS pools on USB insertion
auto_detect = true

# Auto-mount pools without user intervention (only safe for unencrypted)
auto_mount = false

# Require confirmation before importing unknown pools
confirm_unknown_pools = true

[encryption]
# Default encryption algorithm
# Options: aes-128-ccm, aes-192-ccm, aes-256-ccm, aes-128-gcm, aes-192-gcm, aes-256-gcm
default_algorithm = "aes-256-gcm"

# Default key format: passphrase, raw, hex
default_keyformat = "passphrase"

# Minimum passphrase length
min_passphrase_length = 12

[performance]
# Limit ZFS ARC maximum size in MB (0 = use ZFS default)
# Set this on systems with lots of RAM to prevent ZFS from consuming everything
arc_max_mb = 16384

# Default recordsize in KB for new pools
# 128K is good general purpose; 1M (1024) for large sequential files (video)
recordsize_kb = 128

# Disable atime (last access time) to reduce writes
disable_atime = true

# Compression algorithm: on, off, lz4, gzip, zle, lzjb, zstd
compression = "zstd"

# Example pool configuration
# [[pool]]
# name = "wd-black-8tb"
# device_uuid = "usb-WD_BLACK_SN850X_12345"
# auto_import = true
# auto_mount = false
# key_source = "prompt"
